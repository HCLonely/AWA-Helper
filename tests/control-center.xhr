<header>
    <div class="onboarding-container">
    <span class="onboarding_header py-2 d-flex align-items-center">Get Started</span>
    <div class="onboarding_divider"></div>
    <div class="onboarding_items px-4 flex-column">
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link completed" href="/onboarding/item/8" data-description="Learn about what makes Arena great." >
                    What is Arena?
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <span class="text-success toast_arp">+1 ARP</span>
                        <i class="fa-regular fa-square-check"></i>
                                    </div>
            </div>
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link completed" href="/onboarding/item/9" data-description="From the Control Center, you can view today’s Daily, Steam and Twitch Quests and your Daily Login rewards. Select any quest and follow the instructions to begin. Completing quests will earn you ARP." >
                    Where do I find my Quests?
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <span class="text-success toast_arp">+1 ARP</span>
                        <i class="fa-regular fa-square-check"></i>
                                    </div>
            </div>
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link completed" href="/onboarding/item/10" data-description="To participate in Steam, Twitch and Discord quests, you will need to connect your accounts to Alienware Arena. Select the icon under connected accounts to start." >
                    Connected Accounts
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <span class="text-success toast_arp">+1 ARP</span>
                        <i class="fa-regular fa-square-check"></i>
                                    </div>
            </div>
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link completed" href="/onboarding/item/11" data-description="Steam and Twitch require certain settings to be enabled on their side for Arena to properly communicate with them. Review the steps on this page to make sure your accounts are set up correctly." >
                    Verify your Connected Account Settings
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <span class="text-success toast_arp">+1 ARP</span>
                        <i class="fa-regular fa-square-check"></i>
                                    </div>
            </div>
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link completed" href="/onboarding/item/12" data-description="Chat with the Community and earn even more ARP by participating in our daily adventures." >
                    Join Alienware Discord to earn more ARP
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <span class="text-success toast_arp">+1 ARP</span>
                        <i class="fa-regular fa-square-check"></i>
                                    </div>
            </div>
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link completed" href="/onboarding/item/13" data-description="Find new items from the Calendar and Marketplace" >
                    Customize your Avatar
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <span class="text-success toast_arp">+1 ARP</span>
                        <i class="fa-regular fa-square-check"></i>
                                    </div>
            </div>
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link " href="/onboarding/item/14" data-description="Share your thoughts here with the community about anything and everything gaming and Arena related. React to your first relay!" data-img-src="https://media.alienwarearena.com/media/137b94a19b868e12adf48e073fcfa873.jpg">
                    React to your first Relay
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <i class="fa-regular fa-square"></i>
                                    </div>
            </div>
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link completed" href="/onboarding/item/15" data-description="From the Marketplace, you can use your ARP to claim new Avatar items, Artifacts, Dell Rewards, Game Vault and more." >
                    Marketplace
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <span class="text-success toast_arp">+1 ARP</span>
                        <i class="fa-regular fa-square-check"></i>
                                    </div>
            </div>
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link completed" href="/onboarding/item/16" data-description="Artifacts have different powers which can increase the rate you earn ARP, complete tasks and discounts in the Marketplace. Purchase the Starter Set below to get started." data-img-src="https://media.alienwarearena.com/media/d2f2cc325b4438572c0a0be2b99de21b.jpg">
                    Artifacts
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <span class="text-success toast_arp">+1 ARP</span>
                        <i class="fa-regular fa-square-check"></i>
                                    </div>
            </div>
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link completed" href="/onboarding/item/17" data-description="Scroll down to view your Chaotic Artifacts, which can be equipped by selecting the card and clicking equip. Artifacts can only be swapped every 24 hours, so choose wisely." >
                    Equip Your Artifacts
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <span class="text-success toast_arp">+1 ARP</span>
                        <i class="fa-regular fa-square-check"></i>
                                    </div>
            </div>
                    <div class="onboarding_item d-flex justify-content-between">
                <a class="onboarding-link completed" href="/onboarding/item/18" data-description="Complete actions across the site to earn achievements. Complete the onboarding ones now to become a verified member." >
                    Earn Achievements
                </a>

                <div class="d-flex flex-grow-1 justify-content-end align-items-center">
                                            <span class="text-success toast_arp">+1 ARP</span>
                        <i class="fa-regular fa-square-check"></i>
                                    </div>
            </div>
            </div>
</div>

<script type="text/javascript">

    $(function(){
        $('.onboarding_header').click(function () {
            $('.onboarding_items').toggleClass('active');
        });

        $('.onboarding-link').click(function(e) {
            e.preventDefault();

            var description = $(this).data('description');
            var image = $(this).data('img-src');
            
            if (description) {
                localStorage.setItem('one_time_message', description);
            }

            if (image) {
                localStorage.setItem('one_time_image', image);
            }

            window.location.href = $(this).attr('href');
        });
    });
</script>

<style>

    *{
        box-sizing: border-box;
    }
    .onboarding-container{
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 1035;
        width: 400px;
        position: fixed;
        background-color: transparent;
    }
    .onboarding_header{
        color: #fff;
        font-size: 20px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        background-color: #000;
        cursor: pointer;
        justify-content: center;
        text-transform: uppercase;
    }
    .onboarding_items {
        display: none;
        border: 1px solid rgba(255, 255, 255, 0.25);
        background-color: #000;
        padding-top: 10px;
    }
    .onboarding_items.active {
        display: flex;
        margin-bottom: 2px;
    }
    .onboarding_item{
        padding-top: 20px;
        padding-bottom: 20px;
    }
    .onboarding_item a {
        color: #01f5ff;
    }
    .onboarding_item a.completed {
        text-decoration: line-through;
    }
    .onboarding_divider{
        background-color: transparent;
        height: 2px;
    }
    .toast_arp{
        margin-right: 8px;
    }
    @media (max-width: 400px) {
        .onboarding-container{
            width: 100vw !important;
            padding: 0 2px;
        }
        .onboarding_item_text{
            font-size: 15px;
            font-weight: 600;
        }
    }
    @media (max-height: 740px) {
        .onboarding_item {
            padding-top: 0.5vh;
            padding-bottom: 0.5vh;
        }
    }
</style>

