            'code',
            'strikethrough',
            'subscript',
            'superscript'
        ]
    },
    extraPlugins: [CustomUploadAdapterPlugin]
};

function CustomUploadAdapterPlugin(editor) {
    editor.plugins.get('FileRepository').createUploadAdapter = (loader) => {
        return new UploadAdapter(loader, '/ck/image-upload');
    };
}

var ckeditor_config = {};

    ckeditor_config = ckeditor_configs.basic;


var ckeditor_config_file = '/bundles/spoutlet/ckeditor/config.advanced.js';


    $(function() {
    var pi = 60000; // 1 minute interval between polls
    var pollTimeout;

    function queueUpdate() {
        pollTimeout = setTimeout(doUpdate, pi);
    }

    function updateRequest(recaptchaToken) {
        $.ajax({
            type: 'post',
            url: '\/tos\/track',
            data: JSON.stringify({ url: window.location.href }),
            success: function(r) {
                //console.log(r);
                if (r.success) {
                    queueUpdate();
                } 
            },
            error: function (err) {
                console.log(err);
            }
        });
    }

    function doUpdate() {
        updateRequest();
    }

    doUpdate();
});

</script>




